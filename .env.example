# =============================================================================
# AZPROJECTS / AL-AZAB CONSTRUCTION - ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. AI Engine (Google Gemini API)
# يتم توفيره تلقائياً من إعدادات المنصة لتحليل التقارير وكود البناء السعودي SBC
GEMINI_API_KEY=

# 2. Daftra ERP / Accounting System (دفترة للمحاسبة وإدارة المشاريع)
# مفتاح الـ API واسم النطاق الفرعي من لوحة تحكم دفترة (الإعدادات > إدارة الـ API)
DAFTRA_API_KEY=
DAFTRA_SUBDOMAIN=
DAFTRA_BASE_URL=

# 3. MagicPlan Cloud API v2 (ماجيك بلان للمخططات والمساقط المعمارية)
# متوفرة من حساب MagicPlan Cloud للأعمال (API & Integrations)
MAGICPLAN_API_KEY=
MAGICPLAN_CUSTOMER_KEY=
MAGICPLAN_BASE_URL=https://cloud.magicplan.app/api/v2

# 4. Cloud SQL / PostgreSQL (قاعدة البيانات السحابية وسياسات RLS)
# يتم ضبطها تلقائياً عند تفعيل Cloud SQL
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# 5. Production & Custom Domain Configuration
APP_URL=https://projects.alazab.com
PRODUCTION_DOMAIN=projects.alazab.com
CUSTOM_DOMAIN=projects.alazab.com

# 6. WhatsApp Business API (اختياري: لربط رسائل الموقع والمهندسين تلقائياً)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# 7. MinIO / S3 Object Storage (اختياري: لتخزين المخططات والصور العالية الدقة)
MINIO_ENDPOINT=storage.alazab.com
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=azprojects-vault
MINIO_USE_SSL=true

