# =============================================================================
# AZPROJECTS / AL-AZAB CONSTRUCTION - PRODUCTION ENVIRONMENT CONFIGURATION
# ملف مثال لمتغيرات البيئة الشاملة للإنتاج (Production)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. إعدادات السيرفر والإنتاج (Server & Production Host)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://projects.alazab.com
PRODUCTION_DOMAIN=projects.alazab.com
CUSTOM_DOMAIN=projects.alazab.com

# -----------------------------------------------------------------------------
# 2. محرك الذكاء الاصطناعي (Google Gemini API)
# -----------------------------------------------------------------------------
# [كيفية الحصول عليه]:
# 1. ادخل إلى منصة Google AI Studio: https://aistudio.google.com
# 2. اضغط على "Get API key" من القائمة الجانبية ثم "Create API key"
# 3. انسخ المفتاح وضعه هنا
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 3. نظام دفترة المحاسبي السحابي (Daftra ERP)
# -----------------------------------------------------------------------------
# [كيفية الحصول على DAFTRA_SUBDOMAIN]:
# هو اسم النطاق الفرعي لحساب شركتك؛ إذا كان رابط الدخول: https://alazab-co.daftra.com
# فإن القيمة هنا هي: alazab-co فقط بدون daftra.com
DAFTRA_SUBDOMAIN=alazab-co
DAFTRA_BASE_URL=https://alazab-co.daftra.com

# [كيفية الحصول على DAFTRA_API_KEY]:
# 1. سجّل الدخول لحسابك في دفترة كمدير نظام (Admin)
# 2. اذهب إلى: الإعدادات (Settings) > إدارة واجهة برمجة التطبيقات (API Management) أو الإضافات والتكاملات
# 3. اضغط على "توليد مفتاح API جديد" (Generate API Key) وانسخ التوكن الناتج
DAFTRA_API_KEY=

# -----------------------------------------------------------------------------
# 4. منظومة المخططات المعمارية (MagicPlan Cloud API v2)
# -----------------------------------------------------------------------------
MAGICPLAN_BASE_URL=https://cloud.magicplan.app/api/v2

# [كيفية الحصول على MAGICPLAN_CUSTOMER_KEY و MAGICPLAN_API_KEY]:
# يتطلب ذلك حساب MagicPlan للأعمال (Business / Enterprise Subscription):
# 1. سجّل الدخول إلى السحابة عبر: https://cloud.magicplan.app
# 2. من القائمة الجانبية ادخل إلى: "API & Integrations"
# 3. ستجد مُعرّف العميل المؤسسي "Customer ID" (ضع قيمته في MAGICPLAN_CUSTOMER_KEY)
# 4. اضغط على "Create New API Key" لتوليد المفتاح السري وانسخه (ضع قيمته في MAGICPLAN_API_KEY)
MAGICPLAN_CUSTOMER_KEY=
MAGICPLAN_API_KEY=

# -----------------------------------------------------------------------------
# 5. سوبابيس (Supabase Cloud / BaaS)
# -----------------------------------------------------------------------------
# [كيفية الحصول على بيانات Supabase]:
# 1. سجّل الدخول إلى: https://supabase.com/dashboard
# 2. اختر مشروعك ثم اذهب إلى: Settings (أيقونة الترس أسفل اليسار) > API
# 3. من قسم "Project URL":
#    - انسخ الرابط كاملاً لـ SUPABASE_URL (مثل: https://xvtnollwvrzpdojgkcbi.supabase.co)
#    - الجزء الأول بين https:// و .supabase.co هو SUPABASE_PROJECT_ID
# 4. من قسم "Project API keys":
#    - انسخ المفتاح العام "anon" "public" وضعه في SUPABASE_ANON_KEY (و VITE_SUPABASE_PUBLISHABLE_KEY)
#    - انسخ المفتاح السري "service_role" وضعه في SUPABASE_SERVICE_ROLE_KEY (يُستخدم في الخادم فقط لتجاوز قيود RLS)
SUPABASE_URL=https://xvtnollwvrzpdojgkcbi.supabase.co
SUPABASE_PROJECT_ID=xvtnollwvrzpdojgkcbi
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# متغيرات الواجهة الأمامية لـ Supabase (Vite Client-side)
VITE_SUPABASE_URL=https://xvtnollwvrzpdojgkcbi.supabase.co
VITE_SUPABASE_PROJECT_ID=xvtnollwvrzpdojgkcbi
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 6. قاعدة بيانات PostgreSQL / Cloud SQL المباشرة
# -----------------------------------------------------------------------------
# بيانات الاتصال المباشر بقاعدة البيانات العلائقية
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=azprojects
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 7. وكيل الذكاء الاصطناعي (Microsoft Azure AI Foundry Agent)
# -----------------------------------------------------------------------------
# [كيفية الحصول على AZURE_AI_PROJECTS_ENDPOINT]:
# 1. افتح بوابة Azure AI Foundry عبر الرابط: https://ai.azure.com
# 2. اختر مشروعك المنشأ، ستجد في الصفحة الرئيسية (Overview) رابط "Project Endpoint"
# 3. مثال للرابط: https://az-ai-resource.services.ai.azure.com/api/projects/az-ai-gateway
# 4. اسم الوكيل المُنشأ في تبويب Agents ورقم إصداره:
AZURE_AI_PROJECTS_ENDPOINT=https://az-ai-resource.services.ai.azure.com/api/projects/az-ai-gateway
AZURE_AI_AGENT_NAME=az-agent-project
AZURE_AI_AGENT_VERSION=2

# -----------------------------------------------------------------------------
# 8. واتساب للأعمال السحابي (WhatsApp Business Cloud API)
# -----------------------------------------------------------------------------
# [كيفية الحصول على المتغيرات]:
# 1. ادخل إلى بوابة المطورين لدى Meta عبر: https://developers.facebook.com
# 2. اختر تطبيقك > من القائمة الجانبية اختر "WhatsApp" > "API Setup":
#    - Phone number ID: ستجده معروضاً بوضوح برقم تعريفي مستقل (ضعه في WHATSAPP_PHONE_NUMBER_ID وليس رقم الهاتف نفسه)
#    - Access Token: للاختبار يمكنك نسخ التوكن المؤقت، وللإنتاج يتم توليد System User Token دائم من Facebook Business Manager
#    - Webhook Secret: الرمز السري المخصص الذي تدخله يدوياً في إعدادات الـ Webhook للتحقق من التوقيع
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 9. التخزين السحابي للملفات والمخططات (MinIO / S3 Object Storage)
# -----------------------------------------------------------------------------
# [كيفية الحصول على MINIO_ACCESS_KEY و MINIO_SECRET_KEY]:
# 1. سجّل الدخول إلى لوحة إدارة سيرفر MinIO الخاص بك (MinIO Console)
# 2. اذهب إلى قسم: Access Keys
# 3. اضغط على "Create Access Key" ثم قم بنسخ المفتاح والمفتاح السري
MINIO_ENDPOINT=storage.alazab.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=azprojects-vault
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
